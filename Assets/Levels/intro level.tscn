[sub_resource type="Shader" id="Shader_12"]
code = "// Chickbry 3D's surfaces, locked to Chickbry's look (chickbry_look.gdshaderinc).
shader_type spatial;
render_mode ambient_light_disabled, fog_disabled, specular_disabled, cull_disabled;
#include \"res://Assets/Levels/intro level_assets/chickbry_look.gdshaderinc\"

uniform vec3 base_color = vec3(0.78);   // display 0..1
uniform float diffusion = 0.8;
uniform float ambience = 0.2;
uniform float specularity = 0.3;
uniform vec3 spec_color = vec3(1.0);     // highlight colour, already toward the base for a metal
uniform float reflection = 0.0;
uniform float metal = 0.0;
uniform float transparency = 0.0;
uniform bool closed = true;              // a solid: a ray through it crosses two faces
uniform float refraction = 1.0;          // index of refraction: glass bends what is seen through it
uniform int glass_shape = 0;             // a solid the ray can be followed through: 1 box, 2 ramp, 3 sphere
uniform vec3 glass_pos = vec3(0.0);      // its centre, turn and size (Chickbry coordinates)
uniform mat3 glass_rot = mat3(1.0);
uniform vec3 glass_size = vec3(1.0);
uniform float roughness = 1.0;           // for Godot's screen-space effects only
uniform float glow = 0.0;                // its own colour given off, shadow or not (paint G1)

uniform int tex_mode = 0;                // 0 none, 1 palette (material.texture), 2 image (material.image)
uniform vec3 tex_pos = vec3(0.0);        // the object's centre (Chickbry coordinates)
uniform mat3 tex_rot = mat3(1.0);        // the object's turn: its own axes in Chickbry's world
uniform float tex_k = 1.0;               // small objects read the texture as if 20 units big
uniform bool tex_world = false;          // the infinite planes read it at the world point
uniform float tex_shade = 1.0;           // Bryce's ground reads a shade darker
uniform vec4 tex_cols[16];               // palette, dark to light (display 0..1)
uniform float tex_cum[16];               // each colour's cumulative share
uniform int tex_n = 0;
uniform float tex_freq = 0.12;
uniform uint tex_seed = 0u;              // object seed + 61, as the renderer uses
uniform sampler2D tex_image : filter_nearest, repeat_disable;
uniform vec2 img_size = vec2(1.0);
uniform float img_scale = 4.0;           // image pixels per world unit
uniform int alpha_mode = 0;              // material.alpha: 1 holes, 2 wisps, 3 the image's own alpha
uniform float coverage = 1.0;            // the solid share
uniform uint alpha_seed = 0u;            // object seed + 97, as the renderer uses

float cb_erf(float x) {   // Abramowitz & Stegun 7.1.26
	float s = sign(x), a = abs(x);
	float t = 1.0 / (1.0 + 0.3275911 * a);
	float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-a * a);
	return s * y;
}
vec3 cb_tex_point(vec3 p) { return tex_world ? p : (transpose(tex_rot) * (p - tex_pos)) * tex_k; }
vec3 cb_tex_palette(vec3 q) {
	float nv = cb_fbm(q * tex_freq + vec3(7.1, 3.3, -5.7), 5, tex_seed, 0.55);
	float u = clamp(0.5 * (1.0 + cb_erf((nv - 0.5) / 0.122 / sqrt(2.0))), 0.0, 1.0);
	int k = 0;
	for (int i = 0; i < 15; i++) if (k + 1 < tex_n && u > tex_cum[k]) k++;
	if (k + 1 < tex_n) {
		float e = tex_cum[k];
		return mix(tex_cols[k].rgb, tex_cols[k + 1].rgb, cb_sstep(e - 0.04, e + 0.04, u));
	}
	return tex_cols[k].rgb;
}
float cb_mirror_wrap(float x, float n) {
	float per = 2.0 * n;
	x = mod(x, per);
	return x >= n ? per - x - 1e-4 : x;
}
vec4 cb_img_fetch(float u, float v) {
	u = cb_mirror_wrap(u + img_size.x / 2.0, img_size.x) - 0.5;
	v = cb_mirror_wrap(v + img_size.y / 2.0, img_size.y) - 0.5;
	ivec2 s = ivec2(img_size);
	int x0 = clamp(int(floor(u)), 0, s.x - 1), y0 = clamp(int(floor(v)), 0, s.y - 1);
	int x1 = min(x0 + 1, s.x - 1), y1 = min(y0 + 1, s.y - 1);
	float fx = clamp(u - float(x0), 0.0, 1.0), fy = clamp(v - float(y0), 0.0, 1.0);
	vec4 a = mix(texelFetch(tex_image, ivec2(x0, y0), 0), texelFetch(tex_image, ivec2(x1, y0), 0), fx);
	vec4 b = mix(texelFetch(tex_image, ivec2(x0, y1), 0), texelFetch(tex_image, ivec2(x1, y1), 0), fx);
	return mix(a, b, fy);
}
vec4 cb_tex_image4(vec3 q, vec3 n) {
	q *= img_scale;
	if (tex_world) return cb_img_fetch(q.x, -q.z);
	vec3 l = transpose(tex_rot) * n;     // the surface's facing in the object's own axes
	vec3 wv = pow(abs(l), vec3(4.0));
	float sum = wv.x + wv.y + wv.z + 1e-12;
	vec4 c = vec4(0.0);
	if (wv.x > 1e-6) c += cb_img_fetch(q.z, -q.y) * wv.x;
	if (wv.y > 1e-6) c += cb_img_fetch(q.x, -q.z) * wv.y;
	if (wv.z > 1e-6) c += cb_img_fetch(q.x, -q.y) * wv.z;
	return c / sum;
}
vec3 cb_tex_image(vec3 q, vec3 n) { return cb_tex_image4(q, n).rgb; }
// how solid the surface is here (render.cpp tex_solid): 1 everywhere without material.alpha
float cb_solid(int mode, float cov, bool own_image, vec3 p, vec3 n) {
	if (mode == 0) return 1.0;
	vec3 q = cb_tex_point(p);
	if (mode == 3 && own_image) return clamp(cb_tex_image4(q, n).a, 0.0, 1.0);
	float f = tex_freq * 0.8;
	float nv = cb_fbm(vec3(q.x * f - 4.1, q.y * f + 8.3, q.z * f + 1.9), 5, alpha_seed, 0.55);
	float v = clamp(0.5 * (1.0 + cb_erf((nv - 0.5) / 0.122 / sqrt(2.0))), 0.0, 1.0);
	if (mode == 1) {   // a web of strands with holes between: cages, leaves
		float ridge = 1.0 - abs(2.0 * v - 1.0);
		return cb_sstep(1.0 - cov - 0.02, 1.0 - cov + 0.02, ridge);
	}
	return cb_sstep(1.0 - cov - 0.12, 1.0 - cov + 0.12, v);   // soft wisps with dense cores
}
float cb_tex_solid(vec3 p, vec3 n) { return cb_solid(alpha_mode, coverage, tex_mode == 2, p, n); }
uniform float bump = 0.0;                // the texture's noise as relief (render.cpp trace(): pm.bump)
uniform uint bump_seed = 0u;             // object seed + 83
// render.cpp trace(): a bumpy material tilts the normal by its noise's slope, in the object's frame
vec3 cb_bumped(vec3 n, vec3 p) {
	if (bump == 0.0 || tex_world) return n;
	vec3 q = cb_tex_point(p);
	float f = tex_freq * 1.5, e = 0.35;
	vec3 o = vec3(2.9, -1.3, 4.4);
	float c0 = cb_fbm(q * f + o, 4, bump_seed, 0.55);
	vec3 g = vec3(cb_fbm((q + vec3(e, 0.0, 0.0)) * f + o, 4, bump_seed, 0.55) - c0,
			cb_fbm((q + vec3(0.0, e, 0.0)) * f + o, 4, bump_seed, 0.55) - c0,
			cb_fbm((q + vec3(0.0, 0.0, e)) * f + o, 4, bump_seed, 0.55) - c0) / e;
	g = tex_rot * g;
	return normalize(n - (g - n * dot(g, n)) * (6.0 * bump));
}
vec3 cb_textured(vec3 base, vec3 p, vec3 n) {
	if (tex_mode == 1 && tex_n > 0) return cb_tex_palette(cb_tex_point(p)) * tex_shade;
	if (tex_mode == 2) return cb_tex_image(cb_tex_point(p), n) * tex_shade;
	return base;
}

void fragment() {
	vec3 p = cb_world((INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz);
	vec3 eye = cb_world(CAMERA_POSITION_WORLD);
	vec3 n = normalize(cb_world((INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).xyz));
	vec3 d = normalize(p - eye);
	float dist = length(p - eye);
	vec2 drift = wind * (TIME * flow_speed);
	// a mirror's camera (it lacks its plane's layer) sees nothing under the plane, as
	// Chickbry's reflected rays can't: no rock's sunken half shows in the water
	if (CB_GROUND_MIRROR && (CAMERA_VISIBLE_LAYERS & CB_GROUND_LAYER_BIT) == 0u && p.y < CB_GROUND_Y) discard;
	if (CB_WATER && (CAMERA_VISIBLE_LAYERS & CB_WATER_LAYER_BIT) == 0u && p.y < CB_WATER_Y) discard;
	// that camera sits under its plane; Chickbry's reflected ray meets haze only from the plane
	// on (the stretch to the eye is the plane's own): start the air where the ray leaves it
	float mirror_y = CB_GROUND_MIRROR && (CAMERA_VISIBLE_LAYERS & CB_GROUND_LAYER_BIT) == 0u ? CB_GROUND_Y
			: CB_WATER && (CAMERA_VISIBLE_LAYERS & CB_WATER_LAYER_BIT) == 0u ? CB_WATER_Y : 1e30;
	if (mirror_y < 1e29 && eye.y < mirror_y && p.y > mirror_y) {
		eye += (p - eye) * ((mirror_y - eye.y) / (p.y - eye.y));
		dist = length(p - eye);
	}

	vec3 base = cb_textured(base_color, p, n);
	n = cb_bumped(n, p);

	float dif = diffusion, amb = ambience, rw = reflection, tw = transparency, gl = glow;

	vec3 lit = cb_light(base, n, d, dif, amb, specularity, spec_color, 40.0, false) + base * gl;
	vec3 dark = cb_light(base, n, d, dif, amb, specularity, spec_color, 40.0, true) + base * gl;
	if (rw + tw > 1.0) { rw /= rw + tw; tw = 1.0 - rw; }
	vec3 rest = vec3(0.0);
	if (rw > 0.0) rest += cb_mirror_tint(cb_seen(p, reflect(d, n), eye, drift), base, metal * (1.0 - transparency)) * rw;
	lit = lit * (1.0 - rw) + rest;
	dark = dark * (1.0 - rw) + rest;
	cb_lit = cb_linear(cb_atmosphere(lit, eye, d, dist));
	cb_dark = cb_linear(cb_atmosphere(dark, eye, d, dist));
	cb_lamp = cb_linear(base) * (dif / 0.8) * (1.0 - rw - tw);
	ROUGHNESS = roughness;
	if (CAMERA_VISIBLE_LAYERS == CB_DEPTH_LAYER_BIT) {   // a mirror's depth picture: how far behind the plane
		cb_lit = vec3(dist / CB_DEPTH_RANGE);
		cb_dark = cb_lit;
		cb_lamp = vec3(0.0);
	}
	ALBEDO = vec3(1.0);
	METALLIC = 0.0;
	SPECULAR = 0.0;
	EMISSION = cb_lit;
}

void light() {
	DIFFUSE_LIGHT += cb_light_pass(LIGHT_IS_DIRECTIONAL, ATTENUATION, LIGHT_COLOR, dot(NORMAL, LIGHT), cb_lit, cb_dark, cb_lamp);
}
"

